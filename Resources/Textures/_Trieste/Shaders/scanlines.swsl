light_mode unshaded;

void fragment() {
     highp vec2 uv = UV; // 0..1 across the overlay control
     highp float y = FRAGCOORD.y + TIME * 8.0;
     highp float line = mod(y, 4.0);
     highp float scanAlpha = line < 2.0 ? 0.35 : 0.0;

     // Vignette: Since a proper CRT curvation effect is too expensive,
     // we do shadows with a distance from the center.
     // This has slightly more fall-off from top to bottom than the sides.
     highp vec2 centered = uv - vec2(0.5, 0.5);
     highp float dist = length(centered * vec2(1.0, 1.15));
     highp float vignette = smoothstep(0.3, 0.75, dist);

     highp float alpha = max(scanAlpha, vignette * 0.6);
     COLOR = vec4(0.0, 0.0, 0.0, alpha);
}
